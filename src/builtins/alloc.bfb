<> You may include this module at any point in your program, but please only
<> call the alloc_init function after your final declaration. The alloc_init
<> function converts new variable space into memory for use with this module.

<> Many other builtin modules and operators use the features of this module,
<> so it's highly likely that you'll end up including this module in most of
<> your BFB programs. For example: both the `*>` and `:>` builtin operators
<> use the memory that this module manages.

<> Variables
_alloc_mem_start = 0
_alloc_mem_activated = 0

_malloc_ptr = 0

def alloc_init {
    <> + 4 to create some space between the top address and the first
    <> memory address
    _alloc_mem_start = addr + 4
    _alloc_mem_activated = 1
}

def alloc_warn {
    print '(alloc.bfb) Warning: memory allocation not activated, '
    print 'use alloc_init() before allocating memory'
    print '\n'
}

def malloc {
    if !_alloc_mem_activated {
        alloc_warn()
    }

    <> Args
    <> r0: size of allocation

    _malloc_ptr = _alloc_mem_start
    _alloc_mem_start += r0

    <> Return pointer to allocated memory
    ret _malloc_ptr
}

<> Used to allocate an unsized memory chunk (must be given a size before more
<> memory can be allocated)
def malloc_unsized {
    if !_alloc_mem_activated {
        alloc_warn()
    }

    ret _alloc_mem_start
}

<> Usually used after malloc_unsized; realloc_last will increase the size of
<> the most recently allocated memory chunk
def realloc_last {
    if !_alloc_mem_activated {
        alloc_warn()
    }

    <> Args
    <> r0: size to increase by

    _alloc_mem_start += r0
}
