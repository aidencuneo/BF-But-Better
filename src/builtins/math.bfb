<> Variables
_factorial_result = 0
_factorial_i = 0

<> Calculate the factorial of a number
def factorial {
    <> Args
    <> r0: Number to calculate the factorial of

    _factorial_result = 1
    _factorial_i = 2

    while _factorial_i <= r0 {
        _factorial_result *= _factorial_i
        ++_factorial_i
    }

    ret _factorial_result
}
