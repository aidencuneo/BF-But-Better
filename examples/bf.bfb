<> Arrays
dec code_arr 1024
dec memory_arr 128

<> Builtins
include string

<> Collect code
code = &code_arr
code_len = scan(code, 0)

<> Program start
dec scope
dec break_var
dec c

ptr = &memory_arr

for i = 0; i != code_len; ++i {
    <> Current character
    c = *(code + i)

    <> print c
    <> print ' '
    <> printnum i
    <> print '\n'

    if c == '+' { ptr := (*ptr) + 1 }
    if c == '-' { ptr := (*ptr) - 1 }
    if c == '>' { ++ptr }
    if c == '<' { --ptr }
    if c == ',' { ptr := input }
    if c == '.' { print *ptr }
    if c == '[' {
        <> Skip to ']' if !(*ptr)
        if !(*ptr) {
            scope = 1
            break_var = 0

            <> Iterate through code until corresponding ']' is reached
            while (i != code_len) and (break_var == 0) {
                ++i

                if (*(code + i)) == '[' {
                    ++scope
                }

                if (*(code + i)) == ']' {
                    --scope
                }

                <> Break once scope 0 is reached
                if scope == 0 {
                    break_var = 1
                }
            }
        }
    }
    if c == ']' {
        <> Rewind to '[' if mem[ptr]
        <> (Pretty much the same as what happens with '[', but backwards)
        if *ptr {
            scope = 1
            break_var = 0

            <> Iterate through code until corresponding '[' is reached
            while i and (break_var == 0) {
                --i

                if (*(code + i)) == ']' {
                    ++scope
                }

                if (*(code + i)) == '[' {
                    --scope
                }

                <> Break once scope 0 is reached
                if scope == 0 {
                    break_var = 1
                }
            }
        }
    }
}
