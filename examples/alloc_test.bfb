include alloc
include string

dec code
dec code_size
dec ptr2

alloc_init()

code = malloc_unsized()
code_size = getline(code, 0)
realloc_last(code_size + 1)

ptr2 = malloc(18)

printnum code
print '\n'

ptr2 :> 'aiden'
ptr2 + strlen(ptr2) :> 'blishen'
ptr2 + strlen(ptr2) :> 'cuneo'

print 'First: '
printf(code)
print ' ;; Second: '
printf(ptr2)
print ' ;;\n'
